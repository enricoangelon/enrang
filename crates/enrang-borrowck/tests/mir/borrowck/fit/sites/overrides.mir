@override fn Sub::take(_1: &Sub) -> i64 perms(read) sources() result none; //~ EN0615
@override fn Sub::adopt(_1: &Sub, _2: &Lexer) -> void perms(write, read) sources() stores(1 -> 0) result none; //~ EN0615
