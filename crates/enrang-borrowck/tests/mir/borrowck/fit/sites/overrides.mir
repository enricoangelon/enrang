}
fn Base::set(_1: &Base, _2: i64) -> void perms(read) sources() result none;
fn Base::get(_1: &Base, _2: &i64) -> &i64 perms(read, read) sources(0) result writable;
fn Base::label(_1: &Base) -> &string perms(read) sources(0) result writable;
move fn Base::take(_1: &Base) -> i64 perms(own) sources() result none;
fn Base::adopt(_1: &Base, _2: &Lexer) -> void perms(write, read) sources() stores(1 -> 0 fields_only) result none;
