// One report per mistake at a loop's source (A:1263): the hold, the head's `Len`
// and the bind's `Ref` all carry the source's span (plan c.13), so one EN0708 at
// the second loop's source, where its hold, `Len` and `Ref` read `q` while `keep`
// may still write into it; the first loop alone compiles (turn keys).
// Source:
//   oneReport(): let q: i64[2] = [1, 2]; let other = 0; let keep = &other;
//     for (const x of &q) { *x = 1; keep = x; }
//     for (const y of &q) { const v = *y; }
//     return *keep;
// Run by `loops.rs` with c.13's spans: the head's `Len` and `check_tag` run and the
// bind's `check_bounds`, `check_tag` run and `Ref` take the loop's span.
fn oneReport() -> i64 {
  let mut _1: i64[2]; // q
  let _2: i64; // other
  let mut _3: &i64; // keep
  let _4: isize #i;
  let _5: isize #n;
  let _6: bool temp;
  let _7: &i64; // x
  let _8: &i64 temp;
  let _9: isize #i;
  let _10: isize #n;
  let _11: bool temp;
  let _12: &i64; // y
  let _13: i64; // v
  loop l0: path _1 preheader bb1 head bb2 bind bb3[2] binding _7;
  loop l1: path _1 preheader bb5 head bb6 bind bb7[2] binding _12; //~ EN0708
  bb0: {
    storage_live(_1);
    _1 = fixed<i64>[const 1: i64, const 2: i64];
    storage_live(_2);
    _2 = const 0: i64;
    storage_live(_3);
    _3 = &_2 [explicit];
    goto bb1;
  }
  bb1: {
    storage_live(_4);
    _4 = const 0: isize;
    goto bb2;
  }
  bb2: {
    _5 = len(_1);
    _6 = lt(copy _4, copy _5);
    switch move _6 [0: bb9, otherwise: bb3];
  }
  bb3: {
    storage_live(_7);
    check_bounds(copy _4, copy _5);
    _7 = &_1[_4] [for-of-element];
    _4 = add(copy _4, const 1: isize);
    goto bb4;
  }
  bb4: {
    *_7 = const 1: i64;
    _8 = &*_7 [reborrow];
    _3 = move _8;
    storage_dead(_7);
    goto bb2;
  }
  bb9: {
    storage_dead(_4);
    goto bb5;
  }
  bb5: {
    storage_live(_9);
    _9 = const 0: isize;
    goto bb6;
  }
  bb6: {
    _10 = len(_1);
    _11 = lt(copy _9, copy _10);
    switch move _11 [0: bb10, otherwise: bb7];
  }
  bb7: {
    storage_live(_12);
    check_bounds(copy _9, copy _10);
    _12 = &_1[_9] [for-of-element];
    _9 = add(copy _9, const 1: isize);
    goto bb8;
  }
  bb8: {
    storage_live(_13);
    _13 = copy *_12;
    storage_dead(_13);
    storage_dead(_12);
    goto bb6;
  }
  bb10: {
    storage_dead(_9);
    _0 = copy *_3;
    storage_dead(_3);
    storage_dead(_2);
    storage_dead(_1);
    return;
  }
}
