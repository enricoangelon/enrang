    _1 = const "a": string;
    _3 = &_1 [compound-target];
    _4 = form append(move _3, const "?": &string) -> bb1;
  }
  bb1: {
    storage_live(_2);
    _2 = move _1; //~ EN0621
    _3 = &_1 [auto-borrow];
    _4 = form log(move _3) -> bb2;
  }
  bb2: {
    drop(_2);
    storage_dead(_2);
    drop(_1);
    storage_dead(_1);
    return;
  }
}
