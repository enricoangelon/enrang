//                     const r = &o.inner; const p = r.dst; r.src = p; }                // EN0616: `Copier`'s flag, all of held(o)
//   payload(s, d) { let n: Copier | null = new Copier { src: s, dst: d, pos: 0 };
//                   if (n != null) { const r = &n; const p = r.dst; r.src = p; } }     // EN0616: n's payload counts as n, wfields(n)
