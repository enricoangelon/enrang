// TESTING 18's D rows and FV-02 rows whose codes `held` and the access check give
// alone (plan Appendix A): D20-core-3 (first program), D20-core-4 (the `Wrapper`
// form), D20-core-7, FV-02-alias.
// Source:
//   core3(): let pair: [&string, int] = ["none", 0]; { const tmp = mk(); const t = &pair; *t = [&tmp, 1]; }
//            console.log(pair[0]);                                       // EN0711 where `tmp` is dropped
//   core4(src: &string): let lx = new Lexer(src); let w = new Wrapper(&lx);
//            { const tmp = mk(); w.retarget(&tmp); } console.log(lx.next());   // EN0711: the store reaches `lx`
//   core7(s: &string, t: &string): let lx = new Lexer(s); let ly = new Lexer(t);
//            const a = lx.next(); const b = lx.next(); lx.swapWith(&ly); const c = lx.next(); const d = ly.next();
//            console.log(a); console.log(d);                             // compiles
//   alias(s: &Slice<u8>, d: &Slice<u8>): Copier { let w = Copier.make(s, d); const p = w.dst; w.src = p; return w; }
//                                                                         // EN0616 at the store, EN0709 at `return w`
//   peek(s, d): &Slice<u8> { const c = new Copier { src: s, dst: d, pos: 0 }; return c.peek(); }
//                                     // `through_read`: the result holds `c`'s read set alone; EN0710 is r3's (2F)
// Shapes: a tuple literal of a constant view and a number (c.5, c.18), a whole
// write through `*t` (c.8), the scope end's `drop` then `storage_dead` (c.3), the
// constructor call `&dest [auto-borrow]` last then `C::#ctor(move _r, ..)` with
// `this` first (c.10, i.28), receivers' auto-borrows after the arguments (c.2),
// a part copy of a local tuple (A:935), a static method's call (c.7), a field copy
// and a field write of a local value (A:935, c.8), `return w` as a move into `_0`
// (c.9).
@final class Lexer {
  src: readonly &string;
  pos: isize;
}
@final class Wrapper {
  lx: &Lexer;
}
@final class Copier writes_through_fields {
  src: readonly &Slice<u8>;
  dst: &Slice<u8>;
  pos: isize;
}
fn mk() -> string;
fn Lexer::#ctor(_1: &Lexer, _2: &string) -> void perms(write, read) sources() stores(1 -> 0 read) result none;
fn Lexer::next(_1: &Lexer) -> &string perms(write) sources(0) through_fields(0) stores(0 -> 0 fields_only read) result readonly(string_part);
fn Lexer::swapWith(_1: &Lexer, _2: &Lexer) -> void perms(write, write) sources() stores(1 -> 0 fields_only read, 0 -> 1 fields_only read) result none;
fn Wrapper::#ctor(_1: &Wrapper, _2: &Lexer) -> void perms(write, read) sources() stores(1 -> 0) result none;
fn Wrapper::retarget(_1: &Wrapper, _2: &string) -> void perms(read, read) sources() stores(1 -> 0) result none;
static fn Copier::make(_1: &Slice<u8>, _2: &Slice<u8>) -> Copier perms(read, write) sources(0, 1) result none;
fn Copier::peek(_1: &Copier) -> &Slice<u8> perms(read) sources(0) through_read(0) result readonly(readonly_field Copier.src);

