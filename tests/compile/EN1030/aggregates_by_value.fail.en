//! target: x86_64-windows
@dll("kernel32.dll") public declare function ByValue(p: Point): void; //~ EN1030 "this foreign ABI is not supported yet"

@dll("kernel32.dll") public declare function Boxed(b: Box<i32>): void; //~ EN1030 "this foreign ABI is not supported yet"

@dll("kernel32.dll") public declare function Tup(t: [i32, i32]): void; //~ EN1030 "this foreign ABI is not supported yet"

@dll("kernel32.dll") public declare function Obj(o: { x: i32 }): void; //~ EN1030 "this foreign ABI is not supported yet"

@dll("kernel32.dll") public declare function Payload(c: Shape): void; //~ EN1030 "this foreign ABI is not supported yet"

@dll("kernel32.dll") public declare function Iface(c: Eq): void; //~ EN1030 "this foreign ABI is not supported yet"

public type Cb = @abi("win64") unsafe fn() => Point; //~ EN1030 "this foreign ABI is not supported yet"

public final class Point {
  public x: i32 = 0;
}

public enum Shape {
  Circle { radius: f64 },
  Empty,
}
