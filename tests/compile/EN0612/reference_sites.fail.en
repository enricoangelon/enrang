public class Circle {
  private name: string = "circle";
  public constructor(public radius: f64) {}
  public label(): &string {
    return this.name; //~ EN0612 "missing `&`: `label` returns a reference"
  }
}

public function report(c: &Circle): void {
  console.log(c.radius);
}

public function total(xs: &Slice<i64>): i64 {
  let sum: i64 = 0;
  for (const x of xs) {
    sum += *x;
  }
  return sum;
}
