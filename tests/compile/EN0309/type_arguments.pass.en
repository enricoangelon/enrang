const b: Box<i64> = new Box(1);
const p: Pair<i64, string> | null = null;
const q = pair<i64, string>(1, "a");
const r = pair(2, true);
const s: Result<i64> = Ok(3);
console.log(b, p, q, r, s);

public class Pair<A, B> {
  public a: A;
  public b: B;
}

public function pair<A, B>(a: A, b: B): Pair<A, B> {
  return new Pair { a: a, b: b };
}
