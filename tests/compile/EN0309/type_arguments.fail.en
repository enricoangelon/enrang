const b: Box<i64, i64> = new Box(1); //~ EN0309 "`Box` takes 1 type argument, but 2 were given"
const p: Pair<i64> | null = null; //~ EN0309 "`Pair` takes 2 type arguments, but 1 was given"
const q = pair<i64>(1, 2); //~ EN0309 "`pair` takes 2 type arguments, but 1 was given"
console.log(b, p, q);

public class Pair<A, B> {
  public a: A;
  public b: B;
}

public function pair<A, B>(a: A, b: B): Pair<A, B> {
  return new Pair { a: a, b: b };
}
