let data: i64[] = [1, 2];
let p = new Pad(&data);
p.tup()[0].push(4); //~ EN0614
console.log(data);

private class Pad {
  private t: [readonly &i64[], i32];
  public constructor(v: &i64[]) {
    this.t = [v, 0];
  }
  public first(): readonly &i64 {
    return &this.t[0][0];
  }
  public tup(): &[&i64[], i32] {
    return &this.t;
  }
}
