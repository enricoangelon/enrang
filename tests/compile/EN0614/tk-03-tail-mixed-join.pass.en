//! covers: H27
let grid: i64[][] = [[0], [1], [2, 3]]; const p = tailMixedJoin(&grid, false);
if (p != null) {
  const [p0, p1] = p; const e = &p0[0];
  console.log(*e, *p1);
}

public function tailMixedJoin(xs: &Slice<i64[]>, c: bool): [&i64[], &i64[]] | null { let a: &i64[] = &xs[2]; let n = 0; for (const x of xs.slice(1)) { if (n == 1) { return [a, x]; } if (c) { a = x; } n += 1; } return null; }
