let a0: i64[] = [0];
let b0: i64[] = [1];
let p = new Pad(&a0, &b0);
console.log(p.inner()[0].length());
console.log(p.inner()[1]);

public final class Pad {
  private t: [&i64[], [readonly &i64[], i32]];
  public constructor(a: &i64[], b: &i64[]) {
    this.t = [a, [b, 1]];
  }
  public inner(): &[&i64[], i32] {
    return &this.t[1];
  }
}
