public class Lexer {
  private src: &string;
  private pos: isize = 0;
  public constructor(src: &string) {
    this.src = src;
  }
  public next(): readonly &string | null {
    if (this.pos >= this.src.length()) {
      return null;
    }
    const start = this.pos;
    this.pos = this.src.length();
    return this.src.slice(start, this.pos);
  }
}

public function firstWord(text: &string): readonly &string | null {
  let lx = new Lexer(text.slice(0, 3));
  return lx.next();
}
