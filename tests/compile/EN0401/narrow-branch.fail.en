//! covers: H18
private function use(h: &Holder, c: bool): void {
  if (h.item != null) {
    if (c) {
      wipe(h);
    }
    console.log(h.item.n); //~ EN0401
  }
}

private function wipe(h: &Holder): void {
  h.item = null;
}

private class Item {
  public n: i64 = 1;
}

private class Holder {
  public item: Item | null = new Item();
}
