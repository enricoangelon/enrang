let d = new D();
d.go();
public class B {
  public op: Op = Op.Name { s: "a".toString() };
  public reset(): void { this.op = Op.Add; }
}
public class D extends B {
  public go(): void {
    match (this.op) {
      Op.Name => {
        super.reset();
        console.log(this.op.s); //~ EN0401 "`this.op` may no longer be"
      },
      default => {},
    }
  }
}
private enum Op { Name { s: string }, Add }
