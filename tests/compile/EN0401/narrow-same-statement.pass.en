//! covers: H18
let o: Acc | null = new Acc();
if (o != null) {
  o.add(peek(&o));
}
let p: Acc | null = new Acc();
if (p != null) {
  p.n = peek(&p);
}

private class Acc {
  public n: i64 = 0;

  public add(k: i64): void {
    this.n += k;
  }
}

private function peek(a: &(Acc | null)): i64 {
  return *a == null ? 0 : 1;
}
