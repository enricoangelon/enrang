const pets: Box<Animal>[] = [new Box(new Animal("Generic")), new Box(new Dog("Fido"))];
for (const p of &pets) {
  console.log(p.speak());
}
console.log(wrap(5));

private function wrap(x: i64): Result<i64 | null> {
  return Ok(x);
}

public class Animal {
  protected name: string;

  public constructor(name: string) { this.name = name; }

  public speak(): string { return `${this.name} makes a sound`; }
}

public class Dog extends Animal {
  public override speak(): string { return `${this.name} barks`; }
}
