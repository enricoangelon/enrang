//! covers: H18
let h = new Holder();
if (h.item != null) {
  reset();
  console.log(h.item.n);
}

function reset(): void {
  console.log(h.count());
}

private class Item {
  public n: i64 = 1;
}

private class Holder {
  public item: Item | null = new Item();

  public drop(): void {
    this.item = null;
  }

  public count(): i64 {
    return this.item == null ? 0 : 1;
  }
}
