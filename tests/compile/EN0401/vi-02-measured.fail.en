const sector: u8[4] = [7, 7, 7, 7];
show(sector.slice(0, 2)); //~ EN0401 "`T` can't stand for the view `Slice<u8>`"
let s = "hello".toString();
show(s.slice(1, 3)); //~ EN0401 "a `&string` can't become a `&Measured`, because it may be a part of a string"
show(&s); //~ EN0401 "a `&string` can't become a `&Measured`, because it may be a part of a string"

private function show<T extends Measured>(x: &T): void {
  const m: &Measured = x;
  console.log(m.length());
}

public interface Measured {
  length(): isize;
}

public interface Sizer {
  size<T extends Measured>(x: &T): isize;
}

public class LenSizer implements Sizer {
  public size<T extends Measured>(x: &T): isize {
    const m: &Measured = x; //~ EN0401
    return m.length();
  }
}
