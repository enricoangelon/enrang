//! covers: H18
private function use(r: &Holder): void {
  if (r.item != null) {
    const [a, b] = [r, 1];
    a.item = null;
    console.log(r.item.n, b); //~ EN0401
  }
}

private class Item {
  public n: i64 = 1;
}

private class Holder {
  public item: Item | null = new Item();

  public count(): i64 {
    return this.item == null ? 0 : 1;
  }
}
