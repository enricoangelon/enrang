//! covers: H38
let buf: u8[] = [1];
let other: u8[] = [5];
const tbl: u8[] = [0];
let s = new Sub(&tbl, &other);
const e = &buf[0];
Base.put(&s, &buf); //~ EN0706
s.step();
s.step();
s.step();
s.step();
console.log(*e);

public class Base {
  private src: readonly &u8[];
  private dst: &u8[];
  public constructor(s: &u8[], d: &u8[]) {
    this.src = s;
    this.dst = d;
  }
  public peek(): readonly &u8 {
    return &this.src[0];
  }
  public step(): void {
    this.dst.push(1);
  }
  public static firstOf(o: &Sub): readonly &u8 {
    return &o.dst[0];
  }
  public adopt(o: &Sub): void {
    this.src = o.dst;
  }
  public static put(o: &Sub, x: &u8[]): void {
    o.dst = x;
  }
}

public final class Sub extends Base {
  public constructor(s: &u8[], d: &u8[]) {
    super(s, d);
  }
}
