let text: string = "abc";
let other: string = "zz";
let a = new Lexer(&text);
let b = new Lexer(&other);
b.copyFrom(&a);
console.log(a.next() ?? "-");
console.log(b.next() ?? "-");

private class Lexer {
  private src: &string;
  private pos: isize;

  public constructor(src: &string) { this.src = src; }

  public next(): &string | null {
    if (this.pos >= this.src.length()) { return null; }
    const start = this.pos;
    this.pos = this.src.length();
    return this.src.slice(start, this.pos);
  }

  public copyFrom(o: &Lexer): void {
    this.src = o.src;
    this.pos = 0;
  }
}
