let data: i64[] = [1, 2, 3];
let p = new Pad(&data);
const e = p.first();
console.log(*e);
p.tup()[0].push(4);

private class Pad {
  private t: [&i64[], i32];
  public constructor(v: &i64[]) {
    this.t = [v, 0];
  }
  public first(): readonly &i64 {
    return &this.t[0][0];
  }
  public tup(): &[&i64[], i32] {
    return &this.t;
  }
}
