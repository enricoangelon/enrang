//! row: `for (const x of &this.items)` in a meth
public class Bag {
  public items: i64[] = [1];
  public fill(): void {
    for (const x of &this.items) {
      console.log(x);
    }
    this.items.push(1);
  }
  public refill(): void {
    for (const x of &this.items) {
      this.reset();
      break;
    }
  }
  public reset(): void { this.items = []; }
}
