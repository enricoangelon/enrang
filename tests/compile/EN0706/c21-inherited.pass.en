let rex = new Dog("Rex".toString());
const tag = rex.label().toString();
rex.rename("Max");
console.log(tag);

public class Animal {
  public constructor(public name: string) {}

  public label(): &string {
    return &this.name;
  }

  public rename(n: &string): void {
    this.name = n.toString();
  }
}

public class Dog extends Animal {}
