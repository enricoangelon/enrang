//! covers: H37
public final class Copier {
  private src: readonly &u8[];
  private dst: &u8[];
  public constructor(s: &u8[], d: &u8[]) {
    this.src = s;
    this.dst = d;
  }
  public static make(s: &u8[], d: &u8[]): Copier {
    return new Copier(s, d);
  }
  public peek(): readonly &u8 {
    return &this.src[0];
  }
  public step(): void {
    this.dst.push(1);
  }
  public static g(): void {
    const tbl: u8[] = [7];
    let out: u8[] = [];
    let c = new Copier(&tbl, &out);
    const rc = &c;
    const a = &rc.src[0];
    c.step();
    c.step();
    console.log(*a, out);
  }
}
