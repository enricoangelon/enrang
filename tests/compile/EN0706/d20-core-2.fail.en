let data: i64[] = [1, 2];
let h = new Holder(&data);
const e = h.first();
h.reset(); //~ EN0706
console.log(*e);

public class Holder {
  private v: &i64[];

  public constructor(v: &i64[]) {
    this.v = v;
  }

  public first(): &i64 {
    return &this.v[0];
  }

  public reset(): void {
    *this.v = [9, 9];
  }
}
