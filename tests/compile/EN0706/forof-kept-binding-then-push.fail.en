//! row: `saved = job; queue.push(s); use(saved);
let queue = ["a", "b"];
let saved: &string | null = null;
for (const job of &queue) {
  saved = job;
  queue.push("s"); //~ EN0706
  use(saved);
}

let q: i64[] = [3, 1];
let best: &i64 | null = null;
for (const x of &q) {
  best = x;
  q.push(1); //~ EN0706
  console.log(best);
}

private function use(s: &string | null): void { console.log(s); }
