//! covers: H37
let buf: u8[] = [1];
let t: [&u8[], i32] = [&buf, 1];
const r = &t;
const e = &r[0][0];
t[0].push(9); //~ EN0706
t[0].push(9); //~ EN0706
t[0].push(9); //~ EN0706
t[0].push(9); //~ EN0706
console.log(*e);

public final class Copier {
  private src: readonly &u8[];
  private dst: &u8[];

  public constructor(s: &u8[], d: &u8[]) {
    this.src = s;
    this.dst = d;
  }

  public peek(): readonly &u8 { return &this.src[0]; }

  public step(): void { this.dst.push(1); }

  public static demo(): void {
    let out: u8[] = [1];
    const tbl: u8[] = [0];
    let c = new Copier(&tbl, &out);
    const rc = &c;
    const d0 = &rc.dst[0];
    c.step(); //~ EN0706
    c.step(); //~ EN0706
    c.step(); //~ EN0706
    c.step(); //~ EN0706
    console.log(*d0);
  }
}
