let rex = new Dog("Rex");
retag(&rex);

private function retag(a: &Animal): void {
  const tag = a.label().toString();
  a.rename("Max");
  console.log(tag);
}

public class Animal {
  protected name: string;

  public constructor(name: string) { this.name = name; }

  public label(): &string { return "animal"; }

  public rename(name: string): void { this.name = name; }
}

public class Dog extends Animal {
  public override label(): &string { return &this.name; }
}
