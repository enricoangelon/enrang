//! row: Under `p != null`: `for (const x of [...
public function copied(c: bool): void {
  let p: string[] | null = c ? ["a"] : null;
  if (p != null) {
    for (const x of [...p]) { p = null; }
  }
}

public function elements(c: bool): void {
  let p: i64[] | null = c ? [1] : null;
  if (p != null) {
    for (const x of &p) { *x = 1; }
  }
}
