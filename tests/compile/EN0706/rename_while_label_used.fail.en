public function show(a: &Animal): void {
  const tag = a.label();
  a.rename("Max"); //~ EN0706 "points into it"
  console.log(tag);
}

public class Animal {
  public constructor(public name: string) {}
  public label(): &string { return "animal"; }
  public rename(n: string): void { this.name = n; }
}

public class Dog extends Animal {
  public constructor(name: string) { super(name); }
  public override label(): &string { return &this.name; }
}
