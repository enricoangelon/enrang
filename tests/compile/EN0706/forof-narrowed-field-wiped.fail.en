  public wipe(): void { this.items = null; }
  public self(): void {
    if (this.items != null) {
      for (const s of &this.items) { //~ EN0401
        wipe(this); //~ EN0706
      }
    }
  }
}

private function wipe(h: &H): void { h.items = null; }

public function direct(h: &H): void {
  if (h.items != null) {
    for (const s of &h.items) { //~ EN0401
      wipe(h); //~ EN0706
    }
  }
}

public function viaClosure(h: &H, f: (let x: &H) => void): void {
  if (h.items != null) {
    for (const s of &h.items) { //~ EN0401
      f(h); //~ EN0706
    }
  }
}

public function optionalCall(h: &H): void {
  if (h.items != null) {
    for (const s of &h.items) { //~ EN0401
