//! row: Source `q: &T[]`: `grow(q)` with a `grow
public function pushes(q: &i64[]): void {
  for (const x of q) {
    console.log(x);
  }
  grow(q);
}

public function clears(q: &i64[]): void {
  for (const x of q) {
    *q = [];
    break;
  }
}

private function grow(v: &i64[]): void { v.push(1); }
