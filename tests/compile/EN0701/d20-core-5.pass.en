const source = "let x";
let r = new Owned(source.clone());
const tmp = "xy" + "z";
useIt(&r, &tmp);
console.log(r.text());

public interface Retarget {
  let retarget(s: &string): void;
}

private class Owned implements Retarget {
  private src: string;
  public constructor(src: string) {
    this.src = src;
  }
  public retarget(s: &string): void {
    this.src = s.clone();
  }
  public text(): &string {
    return &this.src;
  }
}

private function useIt(r: &Retarget, s: &string): void {
  r.retarget(s);
}
