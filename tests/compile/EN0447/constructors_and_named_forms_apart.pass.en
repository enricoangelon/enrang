const b = new User("Ada", 36);
const d = new Dog("Rex");
const p = new Point { x: 1, y: 2 };
const q: Point = { x: 3, y: 4 };
console.log(b.name, d.tricks, p.x, q.y);

public class User {
  public constructor(public name: string, public age: i64) {}
}

public class Animal {
  public constructor(public name: string) {}
}

public class Dog extends Animal {
  public tricks: i64 = 0;
}

public class Point {
  public x: i64;
  public y: i64;
}
