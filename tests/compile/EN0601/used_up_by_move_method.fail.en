const e = new Envelope { inside: new Letter { text: "hi" } };
const l = e.open();
console.log(l.text);
console.log(e.inside.text); //~ EN0601 "`e` was used up by `open`"

public class Letter {
  public text: string;
}

public class Envelope {
  public inside: Letter;
  public move open(): Letter {
    return this.inside;
  }
}
