  let big: A<A<u64>>; //~ EN0435 "the stack frame of `f` is too large for `x86_64-linux`"
}

public function g(): void {
  const huge: u8[3000000000] = [0; 3000000000]; //~ EN0435 "the stack frame of `g` is too large for `x86_64-linux`"
