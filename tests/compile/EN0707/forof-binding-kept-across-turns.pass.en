//! row: `let prev: &i64 \| null = null; for (cons
let xs: i64[] = [1, 2, 3];
let prev: &i64 | null = null;
for (const x of &xs) {
  if (prev != null) { *prev = 9; }
  prev = x;
}
console.log(xs);

let q: i64[] = [1, 5, 3, 7];
const c = q.length() > 2;
let keep: &i64 | null = null;
for (const x of &q) {
  if (c) { keep = x; }
}
use(keep);

private function use(r: &i64 | null): void {
  if (r != null) { *r = 0; }
}
