const e = new Envelope { inside: new Letter { text: "hi" } };
const l = e.open();
console.log(l.text);

public class Letter {
  public text: string;
}

public class Envelope {
  public inside: Letter;
  public move open(): Letter {
    return this.inside; //~ EN0607 "cannot move `this.inside` out of `this`, because `Envelope` has a destructor"
  }
  public destructor() {
    console.log("bye");
  }
}
