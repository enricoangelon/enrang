public class Person {
  public constructor(public name: string) {}
}

public class Pet {
  public owner: Person;
  public name: string;

  public constructor(name: string, owner: Person) {
    this.name = name;
    console.log(this.describe()); //~ EN0610 "`owner` is not set"
    this.owner = owner;
  }

  public describe(): string {
    return this.name.clone();
  }
}
