const d = new Dog();
console.log(d.sound);

public class Animal {
  public sound: string = "...";

  public constructor() {
    console.log(`ctor: ${this.sound}`);
  }
}

public class Dog extends Animal {
  public override sound: string = this.sound.toUpperCase(); //~ EN0610 "`this` can't be used in a field initialiser"
}
