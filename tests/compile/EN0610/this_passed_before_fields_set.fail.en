public class Person {
  public constructor(public name: string) {}
}

public class Pet {
  public owner: Person;

  public constructor(owner: Person) {
    show(this); //~ EN0610 "`owner` is not set"
    this.owner = owner;
  }
}

public function show(p: &Pet): void {
  console.log(p.owner.name);
}
