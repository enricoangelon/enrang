console.log(new Circle(2, new Person("Ada")).describe());

public class Person {
  public constructor(public name: string) {}
}

public class Shape {
  protected color: string = "red";
  public owner: Person;

  public describe(): string {
    return `${this.color} shape of ${this.owner.name}`;
  }
}

public class Circle extends Shape {
  public constructor(public r: i64, o: Person) {
    super();
  } //~ EN0610 "`owner` is not set"
}
