console.log(new Circle(2, new Person("Ada")).describe());
const plain = new Disc(new Box(2));
console.log(plain.color);

public class Person {
  public constructor(public name: string) {}
}

public class Shape {
  protected color: string = "red";
  public owner: Person;

  public describe(): string { return `${this.color} shape of ${this.owner.name}`; }
}

public class Circle extends Shape {
  public constructor(public r: i64, o: Person) {
    super();
    this.owner = o;
  }
}

public class Painted {
  public color: string = "red";
}

public class Disc extends Painted {
  private r: Box<i64>;

  public constructor(r: Box<i64>) {
    this.r = r;
    super();
  }
}
