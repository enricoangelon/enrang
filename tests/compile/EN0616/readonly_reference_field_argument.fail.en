public final class ByteLexer {
  private src: readonly &Slice<u8>;
  public constructor(src: &Slice<u8>) {
    this.src = src;
  }
  public wipe(): void {
    fill(this.src, 0); //~ EN0616 "cannot write through `this.src`, because it is `readonly &`"
  }
}

public function fill(xs: &Slice<u8>, v: u8): void {
  for (const x of xs) {
    *x = v;
  }
}
