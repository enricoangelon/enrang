let grid: i64[][] = [[1, 2], [3]];
const [x, y] = lastTwice(&grid);
if (x != null && y != null) {
  clash(x, y); //~ EN0616
}

public function lastTwice(rows: &Slice<i64[]>): [&i64[] | null, &i64[] | null] {
  let t: [&i64[] | null, &i64[] | null] = [null, null];
  for (const r of rows) {
    if (r.length() > 1) { t[0] = r; }
    t[1] = r;
  }
  return t;
}

public function clash(x: &i64[], y: &i64[]): void {
  const first = &x[0];
  *y = [9];
  console.log(*first);
}
