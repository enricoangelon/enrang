//! covers: H40
let root = new Node(); let kid = new Node(); kid.val.push(1); root.kids.push(kid);
const [k, w] = snapDown(&root); const f = &w[0];
console.log(*f, k.val);

public class Node { public val: i64[] = []; public kids: Node[] = []; }

public function pick(t: [&Node, i32], v: &i64[]): [&Node, &i64[]] { return [t[0], v]; }

public function snapDown(let node: &Node): [&Node, &i64[]] { const t: [&Node, i32] = [&node.kids[0], 0]; node = &node.kids[0]; return pick(t, &node.val); }
