let base: string = "x";
let a = new Appender(&base);
a.setS("hi"); //~ EN0616
const t: string = "ok".toString();
a.setS(&t); //~ EN0608
a.add();

public class Appender {
  private s: &string;

  public constructor(s: &string) {
    this.s = s;
  }

  public setS(s: &string): void {
    this.s = s;
  }

  public add(): void {
    *this.s += "!";
  }
}
