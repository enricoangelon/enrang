//! covers: H04
public final class Copier {
  private src: readonly &Slice<u8>;
  private dst: &Slice<u8>;
  public constructor(s: &Slice<u8>, d: &Slice<u8>) {
    this.src = s;
    this.dst = d;
  }
  public step(): void {
    this.dst[0] = this.src[0];
  }
  public fuse(): void {
    this.src = this.dst.slice(0, 1); //~ EN0616 "`src` is declared `readonly &`, so it can't hold a reference from `dst`"
  }
}
