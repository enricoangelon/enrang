//! covers: H34
const tbl: u8[] = [0];
let buf: u8[] = [1];
let c = new Copier(&tbl, &buf);
{
  let y: u8[] = [8, 9];
  new Wrapper(&c).relink(&y);
}
const b = c.peek();
console.log(*b);

public final class Copier {
  private src: readonly &u8[];
  private dst: &u8[];
  public constructor(s: &u8[], d: &u8[]) {
    this.src = s;
    this.dst = d;
  }
  public static make(s: &u8[], d: &u8[]): Copier {
    return new Copier(s, d);
  }
  public peek(): readonly &u8 {
    return &this.src[0];
  }
  public step(): void {
    this.dst.push(1);
  }
  public retarget(v: &u8[]): void {
    this.src = v;
  }
}

public final class Wrapper {
  private cp: &Copier;
  public constructor(cp: &Copier) {
    this.cp = cp;
  }
  public move relink(s: &u8[]): void {
    this.cp.retarget(s); //~ EN0616 "cannot store a reference into a value reached through consumed `this`"
  }
  public static relinkBy(w: Wrapper, s: &u8[]): void {
    w.cp.retarget(s); //~ EN0616 "cannot store a reference into a value reached through by-value `w`"
  }
}

public function relinkPart(t: [&Copier, i32], s: &u8[]): void {
  t[0].retarget(s); //~ EN0616
}
