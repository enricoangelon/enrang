private class ByteLexer {
  private src: readonly &Slice<u8>;
  private pos: isize = 0;

  public constructor(src: &Slice<u8>) {
    this.src = src;
  }

  public poke(): void {
    this.src[0] = 9; //~ EN0616 "src"
  }

  public wipe(): void {
    fill(this.src, 0); //~ EN0616 "src"
  }
}

private function fill(xs: &Slice<u8>, v: u8): void {
  for (let i = 0; i < xs.length(); i += 1) {
    xs[i] = v;
  }
}
