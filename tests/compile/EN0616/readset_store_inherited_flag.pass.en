//! covers: H38
Base.demo();

public class Base {
  private src: readonly &u8[];
  private dst: &u8[];
  public constructor(s: &u8[], d: &u8[]) {
    this.src = s;
    this.dst = d;
  }
  public step(): void {
    console.log(this.dst.length());
  }
  public static demo(): void {
    let buf: u8[] = [1];
    const tbl: u8[] = [0];
    let w = new Sub(&tbl, &buf);
    const r = &w;
    const p = r.dst;
    r.src = p;
  }
}

public final class Sub extends Base {
  public constructor(s: &u8[], d: &u8[]) {
    super(s, d);
  }
}
