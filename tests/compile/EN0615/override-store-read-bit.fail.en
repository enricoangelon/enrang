//! covers: H29
public class Base {
  private dst: &Slice<u8>;

  public constructor(d: &Slice<u8>) {
    this.dst = d;
  }

  public retarget(v: &Slice<u8>): void {
    this.dst = v;
  }
}

public class Sub extends Base {
  private extra: readonly &Slice<u8>;

  public constructor(d: &Slice<u8>, e: &Slice<u8>) {
    this.extra = e;
    super(d);
  }

  public override retarget(v: &Slice<u8>): void { //~ EN0615
    this.extra = v;
  }
}
