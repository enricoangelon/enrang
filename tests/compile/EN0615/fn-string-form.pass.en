let msg: string = "hi";
run(show, &msg);

private function run(f: fn(let s: &string) => void, s: &string): void {
  f(s);
}

private function choose(loud: bool): fn(s: &string) => void {
  return loud ? quote : show;
}

private function show(s: &string): void {
  console.log(s);
}

private function quote(s: &string): void {
  console.log(`"${s}"`);
}
