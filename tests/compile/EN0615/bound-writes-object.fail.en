let k = new Clicks();
tick(&k);

private function tick<T extends Counter>(c: &T): void {
  console.log(c.get());
}

public interface Counter {
  get(): i64;
}

public class Clicks { //~ EN0615 "`get` changes the object, but `Counter` declares that it doesn't"
  private n: i64 = 0;

  public get(): i64 {
    this.n += 1;
    return this.n;
  }
}
