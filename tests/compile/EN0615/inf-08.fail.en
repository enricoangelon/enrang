private function firstTwo<T extends TokenReader>(t: &T): void {
  const a = t.next();
  const b = t.next(); //~ EN0707
  console.log(a, b);
}

private function viaInterface(t: &TokenReader): void {
  const a = t.next();
  const b = t.next(); //~ EN0707
  console.log(a, b);
}

public interface TokenReader {
  let next(): readonly &string | null;
}

public interface LooseReader {
  let next(): &string | null;
}

public class Tokens implements TokenReader {
  private text: &string;
  private pos: isize = 0;

  public constructor(text: &string) { this.text = text; }

  public next(): &string | null {
    if (this.pos >= this.text.length()) { return null; }
    const start = this.pos;
    this.pos += 1;
    return this.text.slice(start, this.pos);
  }
}

public class LooseTokens implements LooseReader { //~ EN0615
  private text: &string;
  private pos: isize = 0;

  public constructor(text: &string) { this.text = text; }

  public next(): &string | null {
    if (this.pos >= this.text.length()) { return null; }
    const start = this.pos;
    this.pos += 1;
    return this.text.slice(start, this.pos);
  }
}
