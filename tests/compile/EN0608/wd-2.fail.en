const l = new Logger();
l.log(GREETING); //~ EN0608 "cannot change `GREETING`, because it is a top-level `const`"

private const GREETING: &string = "hi";
private unsafe let count: i64 = 0;

public class Logger {
  public const log(m: &string): void {
    unsafe {
      count += 1;
    }
    console.log(m);
  }
}
