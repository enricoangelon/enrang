let other: i64[] = [1];
const data: i64[] = [1];
const e = &data[0];
const g = new Grower(&data); //~ EN0608 "`new Grower` can change `v`, but `data` is `const`"
const o = &other[0];
other.push(2); //~ EN0706 "`other` cannot change while `o` still points into it"
console.log(*e, *o);

const kept: i64[] = [1];
const h = new Grower(&kept); //~ EN0608 "`new Grower` can change `v`, but `kept` is `const`"
take(kept); //~ EN0709 "cannot move `kept` while it is borrowed"
h.show();

const v: i64[] = [1];
const r = &v[0];
v.push(2); //~ EN0614 "`v` is `const`, so `push` cannot change it" //~ EN0706 "`v` cannot change while `r` still points into it"
console.log(*r);

private function take(xs: i64[]): void { console.log(xs); }

private class Grower {
  private v: &i64[];
  public constructor(v: &i64[]) {
    this.v = v;
    this.v.push(0);
  }
  public show(): void { console.log(this.v); }
}
