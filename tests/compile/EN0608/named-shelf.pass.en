//! row: `public interface Shelf { book(id: i64):
let lib = new Library();
show(&lib);
rename(&lib);
show(&lib);
const fixed = new Library();
show(&fixed);
showCatalog(&fixed);

private function show(s: &Shelf): void {
  console.log(s.book(1).title);
}

private function rename(s: &Shelf): void {
  s.book(1).title = "Dune";
}

private function showCatalog(s: &Catalog): void {
  console.log(s.book(1).title);
}

public class Book {
  public id: i64 = 0;
  public title: string = "";
}

public interface Shelf {
  book(id: i64): &Book;
}

public interface Catalog {
  book(id: i64): readonly &Book;
}

public class Library implements Shelf, Catalog {
  private books: Book[] = [new Book { id: 1, title: "Emma" }];

  public book(id: i64): &Book {
    return &this.books[id - 1];
  }
}
