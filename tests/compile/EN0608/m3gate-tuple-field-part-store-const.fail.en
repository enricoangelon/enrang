let o: i64[3] = [0, 0, 0];
let h = new H(&o);
h.put();

public class H {
  private t: [&Slice<i64>, i32];
  public constructor(o: &Slice<i64>) { this.t = [o, 0]; }
  public put(): void {
    this.t[0] = &TABLE; //~ EN0608 "cannot change `this.t[0]`, because `TABLE`"
    this.t[0][0] = 9;
  }
}
private const TABLE: i64[3] = [1, 2, 3];
