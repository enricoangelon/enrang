const bytes: u8[] = [1, 2, 3, 4];
const lb = new ByteLexer(&bytes);
let buf: u8[] = [1, 2, 3, 4];
let ly = new ByteLexer(&buf);
const a = ly.next();
const b = ly.next();
console.log(a, b);

private class ByteLexer {
  private src: readonly &Slice<u8>;
  private pos: isize = 0;

  public constructor(src: &Slice<u8>) {
    this.src = src;
  }

  public next(): &Slice<u8> | null {
    if (this.pos >= this.src.length()) {
      return null;
    }
    const start = this.pos;
    this.pos += 2;
    return this.src.slice(start, this.pos);
  }
}
