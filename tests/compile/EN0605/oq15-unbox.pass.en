public function boxedDog(): void {
  const pet: Box<Animal> = new Box(new Dog("Rex"));
  console.log(pet.speak());
  let a = pet.unbox();
}

public function boxedAnimal(): void {
  const pet: Box<Animal> = new Box(new Animal("Generic"));
  console.log(pet.speak());
  let a = pet.unbox();
  console.log(a.speak());
}

public class Animal {
  protected name: string;

  public constructor(name: string) { this.name = name; }

  public speak(): string { return `${this.name} makes a sound`; }
}

public class Dog extends Animal {
  public override speak(): string { return `${this.name} barks`; }
}
