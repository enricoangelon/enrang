let p: string[] | null = ["a"];
const c = p == null;
if (p != null) {
  for (const x of &p) {
    p = null;
    break;
  }
  console.log(p.length()); //~ EN0303 "has no member `length`"
}
if (p != null) {
  outer: for (const a of &p) {
    for (const x of &p) {
      p = null;
      break outer;
    }
  }
  console.log(p.length()); //~ EN0303 "has no member `length`"
}
if (p != null) {
  for (const x of &p) {
    if (c) {
      p = null;
      break;
    }
  }
  console.log(p.length()); //~ EN0303 "has no member `length`"
}
