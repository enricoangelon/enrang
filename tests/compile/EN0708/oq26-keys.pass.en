public function secondLoop(): void {
  let q: i64[] = [1, 5, 3, 7];
  let keep: &i64 | null = null;
  for (const x of &q) {
    if (x > 2) { keep = x; }
  }
  if (keep != null) { *keep = 0; }
  for (const y of &q) {
    console.log(y);
  }
  console.log(q);
}

public function readFirst(): void {
  let q: i64[] = [1, 5, 3, 7];
  let keep: &i64 | null = null;
  for (const x of &q) {
    if (x > 2) { keep = x; }
  }
  if (keep != null) { *keep = 0; }
  console.log(q[0]);
}

public function twoRuns(): void {
  let q: i64[] = [1, 5, 3, 7];
  let n = 0;
  while (n < 2) {
    let keep: &i64 | null = null;
    for (const x of &q) {
      keep = x;
    }
    if (keep != null) { *keep = 0; }
    n += 1;
  }
  console.log(q);
}
