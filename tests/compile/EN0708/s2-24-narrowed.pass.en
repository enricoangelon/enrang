let b = new Bag(); b.items = [1, 5, 3, 7];
let keep: &i64 | null = null; if (b.items != null) { for (const x of &b.items) { if (*x > 2) { keep = x; } } } if (keep != null) { *keep = 0; } console.log(b.items);

let p: i64[] | null = [1, 2, 3];
if (p != null) { for (const x of &p) { *x += 1; } }
console.log(p);

let v: i64[] = [1, 2, 3];
bump(v.slice(0, 3));
console.log(v);

public class Bag { public items: i64[] | null = null; }

public function bump(xs?: &Slice<i64>): void {
  if (xs != null) { for (const x of xs) { *x += 1; } }
}
