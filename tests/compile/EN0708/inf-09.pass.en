let q: i64[] = [1, 5, 3, 7];
let keep: &i64 | null = null;
for (const x of &q) {
  if (x > 2) { keep = x; }
}
if (keep != null) { *keep = 0; }
console.log(q);

let list: i64[] = [1, 5, 3, 7];
const last = findLast(&list);
if (last != null) { *last = 0; }
console.log(list);

public function findLast(list: &Slice<i64>): &i64 | null {
  let keep: &i64 | null = null;
  for (const x of list) {
    if (x > 2) { keep = x; }
  }
  return keep;
}
