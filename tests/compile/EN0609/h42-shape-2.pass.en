//! covers: H42
function setx(let p: &{ x: i64 }): void { p.x = 5; }
function setn(p: &{ x: i64 } | null): void { if (p != null) { p.x = 5; } }
function run(f: (let p: &{ x: i64 }) => void, c: &C): void { f(c); }
const f: fn(let p: &{ x: i64 }) => void = setx;
let c = new C();
f(&c);
setn(&c);
run((let p: &{ x: i64 }): void => { p.x = 5; }, &c);

public class C { public x: i64 = 1; }
