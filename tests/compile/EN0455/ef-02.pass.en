console.log(range(1, 2), none(), empty(), status(), origin());

private function range(lo: i64, hi: i64): Result<[i64, i64]> {
  return [lo, hi];
}

private function none(): Result<isize | null> {
  return null;
}

private function empty(): Result<i64[]> {
  return [];
}

private function status(): Result<u8> {
  return 200;
}

private function origin(): Result<Point> {
  return { x: 1, y: 2 };
}

public type Point = { x: i64, y: i64 };
