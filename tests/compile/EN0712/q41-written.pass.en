fill(&[1, 2, 3], 7);
let q: i64[4] = [2, 3, 5, 7];
const p: &Slice<i64> = &q;
p[0] = 1;
console.log(p);
show(3);

private function fill(xs: &Slice<i64>, v: i64): void {
  let i: isize = 0;
  while (i < xs.length()) {
    xs[i] = v;
    i += 1;
  }
}

private function pair(n: i64): i64[2] {
  return [n, n];
}

private function show(n: i64): void {
  const both: i64[2] = [n, 2];
  const w: &Slice<i64> = &both;
  console.log(w);
}
