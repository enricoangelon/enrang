//! covers: H05
new Selfie(); //~ EN0712 "the temporary is dropped while"
console.log("end");

private class Guard {
  private v: readonly &i64[];
  public constructor(v: &i64[]) { this.v = v; }
  public destructor() { console.log(this.v); }
}
private class Selfie {
  private g: Guard;
  private buf: i64[] = [1, 2, 3];
  public constructor() { this.g = new Guard(&this.buf); }
}
