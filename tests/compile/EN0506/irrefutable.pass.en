const ada = new User { name: "Ada", age: 36 };
const { name: who, age } = &ada;
const xs: i64[] = [3, 1, 2];
const [lo, hi] = minMax(&xs);
let a = 1;
let b = 2;
[a, b] = [b, a];
const maybe: User | null = null;
if (maybe != null) {
  const { name } = &maybe;
  console.log(name);
}
console.log(who, age, lo, hi, a, b);

public class User {
  public name: string;
  public age: i64;
}

public function minMax(xs: &i64[]): [i64, i64] {
  let lo = xs[0];
  let hi = xs[0];
  for (const x of xs) {
    if (*x < lo) {
      lo = *x;
    }
    if (*x > hi) {
      hi = *x;
    }
  }
  return [lo, hi];
}
