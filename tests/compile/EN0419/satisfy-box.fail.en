const boxed = new Box(new Dog {});
console.log(greet(&boxed)); //~ EN0419 "`Box<Dog>` does not satisfy `Speaker`"

private function greet<T extends Speaker>(x: &T): string {
  return x.speak();
}

public interface Speaker {
  speak(): string;
}

public class Dog implements Speaker {
  public speak(): string {
    return "woof";
  }
}
