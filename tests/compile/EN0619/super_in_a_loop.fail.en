public class Animal {
  public constructor(public age: i64) {}
}

public class Dog extends Animal {
  public constructor(age: i64, n: i64) {
    let i = 0;
    while (i < n) {
      super(age); //~ EN0619 "`super(age)` may already have run here"
      i++;
    }
  } //~ EN0619 "`super(age)` isn't called on every path before the constructor returns"
}
