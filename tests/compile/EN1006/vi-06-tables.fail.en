let kept: Box<Dumper> | null = null; //~ EN1006 "an interface type by value outside a parameter is not supported yet"

public interface Dumper {
  dump<T>(x: &T): void;
}

public class Animal {
  public show<T>(x: &T): void {
    console.log("Animal.show:", x);
  }
}

public class Dog extends Animal {
  public override show<T>(x: &T): void { //~ EN0460 "`show` has its own type parameters, so it can't be overridden"
    console.log("Dog.show:", x);
  }
}

public class Pet {
  public show<T>(x: &T): void {
    console.log("Pet.show:", x);
  }
}

public class Cat extends Pet {
  public show<T>(x: &T): void { //~ EN0460 "`show` has its own type parameters, so it can't be overridden"
    console.log("Cat.show:", x);
  }
}

public abstract class Shape {
  public abstract show<T>(x: &T): void; //~ EN0460 "`show` has its own type parameters, so it can't be overridden"
}
